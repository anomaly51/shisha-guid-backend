# Local Docker development uses the workload-1 Kubernetes PostgreSQL instance.
# Start the tunnel first:
#   ./scripts/remote-db-env.sh
#   ./scripts/remote-db-port-forward.sh
DATABASE_URL=postgresql+asyncpg://postgres:<password>@host.docker.internal:15432/shishadb

SECRET_KEY=change-me
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

MINIO_PUBLIC_URL=http://localhost:9000/shisha-guid
OPENROUTER_MODEL=sao10k/l3-lunaris-8b
